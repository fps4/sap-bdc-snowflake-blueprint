# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Generated by `make demo`. The DuckDB databases are large and regenerable, so they
# stay out; `reports/` is committed on purpose — the register and the charts are
# the artifact people read on GitHub without cloning, and CI gates the register
# against the code that produced it.
/data/*.duckdb
/data/share/

# dbt build output. The *generated bindings* under transform/models/staging and
# transform/seeds are committed on purpose — CI gates them against the register, so
# a policy change that never reached the dbt layer shows up in review.
/transform/target/
/transform/dbt_packages/
/transform/logs/

# OS / editor
.DS_Store
.idea/
.vscode/
